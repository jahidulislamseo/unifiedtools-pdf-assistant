{
  "manifest_version": 3,
  "name": "UnifiedTools Pro - PDF & Document Assistant",
  "short_name": "UnifiedTools PDF",
  "version": "1.0.0",
  "description": "Your PDF and document productivity companion. Instantly convert webpages to PDF, analyze text, and integrate with UnifiedTools Pro.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.unifiedtoolspro.xyz/tools/*",
        "*://localhost/*/tools/*",
        "*://localhost/tools/*",
        "http://localhost:3000/tools/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "UnifiedTools PDF Assistant"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
